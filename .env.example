# GEMINI_API_KEY is injected at build time by the Secrets Gradle plugin.
# Local: copy this file to ".env" and set your key (never commit .env).
# CI: set GitHub Actions secret GEMINI_API_KEY (release-apk.yml already reads it).
# Do NOT put real keys in source code or public repos.
GEMINI_API_KEY=MY_GEMINI_API_KEY
